{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "postbuild": "node -e \"require('fs').rmSync('.wrangler/deploy/config.json',{force:true})\"",
    "preview": "npm run build && wrangler dev --config dist/wrangler.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node scripts/test-transform.mjs",
    "consistency": "node scripts/consistency-check.mjs",
    "consistency:live": "node scripts/consistency-check.mjs --live",
    "enrich-databases": "node scripts/enrich-databases.cjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.toml",
    "profile": "node scripts/perf/profile.mjs",
    "profile:mem": "node scripts/perf/profile.mjs mem big800",
    "profile:cmp": "node scripts/perf/profile.mjs cmp"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-superscript": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.98.0"
  }
}
