# Clerk (frontend — Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Supabase (frontend — Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# IdiomOptima API Worker the Transform button calls (Vite).
# Local dev: run `npx wrangler dev` then point at your local worker.
VITE_WORKER_URL=http://127.0.0.1:8787
# Production:
# VITE_WORKER_URL=https://nativewrite-api.nativewrite-api.workers.dev

# Cloudflare Worker env vars (set via `wrangler secret put`, or .dev.vars locally)
# GEMINI_API_KEY=your_gemini_key
# OPENROUTER_API_KEY=your_openrouter_key
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
