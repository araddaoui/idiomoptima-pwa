# Clerk (frontend — Vite) — REQUIRED. The app cannot render without it.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# IdiomOptima API Worker the Transform button calls (Vite).
# Optional: when unset it falls back to the deployed production worker.
# Local dev: run `npx wrangler dev --config wrangler.toml` then point at it.
VITE_WORKER_URL=http://127.0.0.1:8787
# VITE_API_URL is an accepted legacy alias for VITE_WORKER_URL.
# Production:
# VITE_WORKER_URL=https://nativewrite-api.nativewrite-api.workers.dev

# NOTE: Supabase is touched ONLY by the worker, with the service key below.
# There is no frontend Supabase client, so no VITE_SUPABASE_* keys are needed.

# Cloudflare Worker env vars (set via `wrangler secret put`, or .dev.vars locally)
# GEMINI_API_KEY=your_gemini_key
# OPENROUTER_API_KEY=your_openrouter_key
# CLERK_DOMAIN=your-clerk-domain.clerk.accounts.dev
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_PRICE_ID=price_your_subscription_price_id
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
# AI — Cloudflare Workers AI binding, declared in wrangler.toml ([ai] binding = "AI")
